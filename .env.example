FLASK_ENV=development
SECRET_KEY=change-me

APP_BASE_URL=https://markasare.com

EMAIL_PROVIDER=dev
EMAIL_FROM=no-reply@markasare.com
CONTACT_OWNER_EMAIL=
SUPPORT_EMAIL=
ENABLE_AUTO_REPLY=false

MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=

AWS_SES_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# Create a DynamoDB table with partition key pk (String) and sort key sk (String).
VISITOR_ANALYTICS_TABLE=
ANALYTICS_AWS_REGION=us-west-2
ANALYTICS_COOKIE_NAME=visitor_id
ANALYTICS_COOKIE_MAX_AGE=63072000
ANALYTICS_SESSION_WINDOW_SECONDS=1800
# Set this if you want /api/analytics/summary to require a token.
ANALYTICS_READ_TOKEN=